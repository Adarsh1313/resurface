# ── Database (Supabase / Postgres) ─────────────────────────────────────────
# Get both from: Supabase → Project Settings → Database → Connection string
#   "Transaction" mode (pooled, port 6543) → DATABASE_URL  (for queries)
#   "Session" mode (direct, port 5432)     → DATABASE_DIRECT_URL  (for migrations)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated owner/admin accounts allowed to access /dashboard/admin.
ADMIN_EMAILS="founder@example.com"

# Set true when you want private beta signup to require an emailed invite link.
REQUIRE_INVITE=false

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Localhost:3000 and chrome-extension:// are always allowed by default.
ALLOWED_ORIGINS="http://localhost:3000,https://resurface-web-eight.vercel.app"

# ── Email (Resend) ───────────────────────────────────────────────────────
# Leave blank to log emails to console (dev mode).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="Resurface <noreply@yourdomain.com>"
#
# Optional Gmail/SMTP mode. If SMTP_* is set, it is used before Resend.
# For Gmail, enable 2-Step Verification and create an App Password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="your-resurface@gmail.com"
# SMTP_PASS="your-16-character-app-password"
# EMAIL_FROM="Resurface <your-resurface@gmail.com>"

# Public URL used in waitlist/invite emails.
# PUBLIC_APP_URL="https://your-vercel-app.vercel.app"

# ── AI (topic suggestions) ───────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Port ─────────────────────────────────────────────────────────────────
# PORT=4000 (Render sets this automatically in production)
