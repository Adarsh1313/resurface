# ── Database ─────────────────────────────────────────────────────────────
# Local dev (SQLite, default):
DATABASE_URL="file:./dev.db"
# Production (Postgres — Neon/Supabase/Railway). Also switch schema.prisma
# `provider = "postgresql"` before running `prisma migrate deploy`.
# DATABASE_URL="postgresql://user:pass@host:5432/resurface?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Localhost:3000 and chrome-extension:// are always allowed by default.
# ALLOWED_ORIGINS="https://resurface.app,https://www.resurface.app"

# ── Email (Resend) ───────────────────────────────────────────────────────
# Leave blank to log emails to console (dev mode).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="Resurface <onboarding@resend.dev>"

# ── AI (topic suggestions) ───────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Port ─────────────────────────────────────────────────────────────────
# PORT=4000
